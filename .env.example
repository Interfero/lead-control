APP_NAME="Lead Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lead_control
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# SuperPart — те же key/secret, что LEVELION_* в SuperPart
SUPERPART_BASE_URL=http://127.0.0.1:8001
SUPERPART_FALLBACK_URL=
SUPERPART_API_KEY=local-test-key
SUPERPART_API_SECRET=local-test-secret
SUPERPART_API_PER_MINUTE=300
SUPERPART_ORDER_AUTHOR_USER_ID=1
SUPERPART_DEFAULT_SOURCE_ID=1

# Опционально. Для локальной проверки кассы/заказов можно оставить пустым
MANGO_API_KEY=
MANGO_API_SALT=
MANGO_WEBHOOK_SECRET=

GM_API_BASE_URL=
GM_API_BEARER_TOKEN=
GM_API_VERIFY_TLS=true

DESK_API_TOKEN=
DESK_PUBLIC_URL=http://127.0.0.1:8002
DESK_INTERNAL_TOKEN=

HUB_PUBLIC_URL=http://127.0.0.1:8000
UNIFIED_HUB_ENABLED=false
UNIFIED_HUB_WRITE_DRIVER=cache

PHONE_REVEAL_ENABLED=true
BOT_GUARD_ENABLED=false
HR_CC_SUPERVISOR_USER_IDS=
